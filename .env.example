# Copy to .env. Every value works as-is for local development.
# Replace each password and secret below before any shared or production use.

# ── Stores (internal network; compose reads these for substitution) ───────
POSTGRES_PASSWORD=scout
REDIS_PASSWORD=scout-dev-redis
SCOUT_ELASTICSEARCH_PASSWORD=scout-dev-es
SCOUT_VECTOR_DB_API_KEY=scout-dev-qdrant
S3_ACCESS_KEY=scoutaccess
S3_SECRET_KEY=scout-dev-s3-secret

# The server connects to Postgres as scout_app, which cannot bypass row-level
# security (see deploy/sql/init.sql). Do not point this at the scout superuser.
SCOUT_POSTGRES_DSN=postgresql://scout_app:scout_app@postgres:5432/scout

# ── Identity: Keycloak realm "scout" (deploy/keycloak) ────────────────────
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak
SCOUT_AUTH_ISSUER=http://keycloak:8080/realms/scout
SCOUT_AUTH_AUDIENCE=scout-mcp
SCOUT_AUTH_JWKS_URL=http://keycloak:8080/realms/scout/protocol/openid-connect/certs

# ── Embeddings ────────────────────────────────────────────────────────────
# bge-base-en-v1.5 through fastembed (ONNX). 768 dimensions. Seed data and
# queries must use the same model, or vector search returns noise.
SCOUT_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ── Tuning (defaults shown) ───────────────────────────────────────────────
SCOUT_RATE_LIMIT_DEFAULT_RPM=60
SCOUT_RATE_LIMIT_BURST=20
SCOUT_CACHE_L1_TTL_SECONDS=60
SCOUT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
SCOUT_CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# ── Dashboards ────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin

# ── Support copilot (docker compose --profile copilot run --rm copilot "...") ─
# It signs in to Keycloak as this client; see deploy/keycloak/scout-realm.json.
SCOUT_CLIENT_ID=copilot-acme
SCOUT_CLIENT_SECRET=dev-secret-copilot-acme
SCOUT_TENANT=acme
# The address clients use to reach Scout. Served in /.well-known/oauth-protected-resource.
SCOUT_PUBLIC_URL=https://localhost:8443
# Browser origins allowed to call /mcp, as a JSON list. Leave unset to refuse every browser
# origin; agents and CLIs send no Origin and are not affected.
# SCOUT_ALLOWED_ORIGINS=["https://inspector.example"]
SCOUT_LLM_BASE_URL=https://openrouter.ai/api/v1
SCOUT_LLM_MODEL=deepseek/deepseek-v4-flash:free
SCOUT_LLM_API_KEY=sk-or-v1-replace-me
# Prompts contain customer text. With fallback on, they are also sent to the other
# providers listed in agents/base.py. Leave it off unless you accept that.
SCOUT_LLM_FALLBACK=false
SCOUT_LLM_GROQ_KEY=

# ── Running the copilot from your host instead of compose ─────────────────
# SCOUT_MCP_URL=https://localhost:8443
# SCOUT_TOKEN_URL=http://localhost:8081/realms/scout/protocol/openid-connect/token
# SCOUT_MCP_CA_BUNDLE=./caddy-root.crt   # docker compose cp caddy:/data/caddy/pki/authorities/local/root.crt ./caddy-root.crt
