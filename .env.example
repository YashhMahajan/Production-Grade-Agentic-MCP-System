# Copy to .env. Every value works as-is for local development.
# Replace each password and secret below before any shared or production use.

# ── Stores (internal network; compose reads these for substitution) ───────
POSTGRES_PASSWORD=atlas
REDIS_PASSWORD=atlas-dev-redis
ATLAS_ELASTICSEARCH_PASSWORD=atlas-dev-es
ATLAS_VECTOR_DB_API_KEY=atlas-dev-qdrant
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# The server connects to Postgres as atlas_app, which cannot bypass row-level
# security (see deploy/sql/init.sql). Do not point this at the atlas superuser.
ATLAS_POSTGRES_DSN=postgresql://atlas_app:atlas_app@postgres:5432/atlas

# ── Identity: Keycloak realm "atlas" (deploy/keycloak) ────────────────────
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak
ATLAS_AUTH_ISSUER=http://keycloak:8080/realms/atlas
ATLAS_AUTH_AUDIENCE=atlas-mcp
ATLAS_AUTH_JWKS_URL=http://keycloak:8080/realms/atlas/protocol/openid-connect/certs

# ── Embeddings ────────────────────────────────────────────────────────────
# bge-base-en-v1.5 through fastembed (ONNX). 768 dimensions. Seed data and
# queries must use the same model, or vector search returns noise.
ATLAS_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ── Tuning (defaults shown) ───────────────────────────────────────────────
ATLAS_RATE_LIMIT_DEFAULT_RPM=60
ATLAS_RATE_LIMIT_BURST=20
ATLAS_CACHE_L1_TTL_SECONDS=60
ATLAS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
ATLAS_CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# ── Dashboards ────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin

# ── Support copilot (docker compose --profile copilot run --rm copilot "...") ─
# It signs in to Keycloak as this client; see deploy/keycloak/atlas-realm.json.
ATLAS_CLIENT_ID=copilot-acme
ATLAS_CLIENT_SECRET=dev-secret-copilot-acme
ATLAS_TENANT=acme
ATLAS_LLM_BASE_URL=https://openrouter.ai/api/v1
ATLAS_LLM_MODEL=deepseek/deepseek-v4-flash:free
ATLAS_LLM_API_KEY=sk-or-v1-replace-me
# Prompts contain customer text. With fallback on, they are also sent to the other
# providers listed in agents/base.py. Leave it off unless you accept that.
ATLAS_LLM_FALLBACK=false
ATLAS_LLM_GROQ_KEY=

# ── Running the copilot from your host instead of compose ─────────────────
# ATLAS_MCP_URL=https://localhost:8443
# ATLAS_TOKEN_URL=http://localhost:8081/realms/atlas/protocol/openid-connect/token
# ATLAS_MCP_CA_BUNDLE=./caddy-root.crt   # docker compose cp caddy:/data/caddy/pki/authorities/local/root.crt ./caddy-root.crt
