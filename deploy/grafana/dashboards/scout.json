{
  "uid": "scout-mcp",
  "title": "Scout MCP",
  "tags": [
    "scout"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Tool calls per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "scout-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (rate(scout_tool_calls_total[1m]))",
          "legendFormat": "{{tool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "scout-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Calls by outcome",
      "description": "status is ok or the error code returned to the agent",
      "datasource": {
        "type": "prometheus",
        "uid": "scout-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(scout_tool_calls_total[5m]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "scout-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "scout-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, tool) (rate(scout_tool_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{tool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "scout-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(scout_tool_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{tool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "scout-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, tool) (rate(scout_tool_latency_seconds_bucket[5m])))",
          "legendFormat": "p99 {{tool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "scout-prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Server-side error ratio",
      "description": "Excludes validation, policy and rate-limit rejections, which are caller errors",
      "datasource": {
        "type": "prometheus",
        "uid": "scout-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(scout_tool_calls_total{status=~\"timeout|internal_error|circuit_open|postgres_error|elasticsearch_error|vector_.*|s3_error|http_.*\"}[5m])) / sum(rate(scout_tool_calls_total[5m]))",
          "legendFormat": "errors",
          "datasource": {
            "type": "prometheus",
            "uid": "scout-prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "scout-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(scout_cache_hits_total[5m])) / (sum(rate(scout_cache_hits_total[5m])) + sum(rate(scout_cache_misses_total[5m])))",
          "legendFormat": "hit ratio",
          "datasource": {
            "type": "prometheus",
            "uid": "scout-prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rate-limited calls per second",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "scout-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (rate(scout_rate_limited_total[5m]))",
          "legendFormat": "{{tool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "scout-prometheus"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Circuit breaker state (0 closed, 1 half-open, 2 open)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "scout-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scout_circuit_state",
          "legendFormat": "{{tool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "scout-prometheus"
          }
        }
      ]
    }
  ]
}
